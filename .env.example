# ==============================================================================
# Enterprise AP Invoice Automation Platform — Environment Configuration
# Single Source of Truth: CLAUDE.md §11.1
# NOTE: Zero static credentials in code or repository. Azure uses Managed Identity.
# ==============================================================================

# --- Azure Tenant & Identity (Entra ID Managed Identity) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=system-assigned   # Use managed identity in Azure; service principal locally
AZURE_API_AUDIENCE=               # Optional explicit JWT aud URI (defaults to AZURE_CLIENT_ID / api://<id>)
ENTRA_JWKS_CACHE_TTL_SECONDS=3600
ENTRA_JWT_CLOCK_SKEW_SECONDS=30
CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# --- Redis Rate Limiting (Phase 3 P3-3) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=false
TRUSTED_PROXY_IPS=[]

# --- Azure Services (Strictly East US 2 — ADR-001) ---
AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net/
AZURE_BLOB_WORM_CONTAINER=raw-invoices-immutable
AZURE_SQL_SERVER=<server>.database.windows.net
AZURE_SQL_DATABASE=sqldb-ap-staging
AZURE_KEY_VAULT_URL=
KEY_VAULT_CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379/0   # Leave empty for local in-memory mock

# --- Azure OpenAI East US 2 (Model Gateway — ADR-004) ---
AZURE_OPENAI_ENDPOINT=https://<instance>.openai.azure.com/
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o-vision
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# --- Business Rule Thresholds (Configurable via get_settings() — Never Hardcode) ---
HIGH_VALUE_THRESHOLD_USD=10000.00
PO_VARIANCE_TOLERANCE_PERCENT=5.0
LINE_ROUNDING_TOLERANCE=0.02
INVOICE_ROUNDING_TOLERANCE=0.05

# --- Local Development / Offline Testing Mode (Strict Isolation) ---
USE_LOCAL_SQLITE=true       # Set false for Azure SQL
USE_FAKE_REDIS=true         # Set false for real Redis
USE_MOCK_AOAI=true          # Set false for real Azure OpenAI calls
USE_MOCK_KEY_VAULT=true     # Local dev/test only (hard-blocked in staging/prod)
USE_MOCK_BLOB_STORAGE=true  # Local dev/test only (hard-blocked in staging/prod)
ENABLE_DEMO_AUTH=false      # Local dev/demo only (hard-blocked in staging/prod)
SAMPLE_DATA_DIR=./sample_data


# syntax=docker/dockerfile:1.7
# ==============================================================================
# React UI Image — Enterprise AP Invoice Automation Platform (P14-2)
# Multi-stage hardened build: node:20-alpine -> nginx:1.27-alpine
# Non-root UID 10001 appuser, unprivileged Nginx on port 8080,
# Automated API reverse proxy to FastAPI backend (http://api:8000).
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder — Compile Vite React & Tailwind assets
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies deterministically
RUN npm ci

# Copy frontend application code
COPY frontend/ ./

# Build production bundle into /app/dist
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Runtime — Minimal hardened non-root Nginx server
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="Enterprise AP Invoice Automation React UI" \
      org.opencontainers.image.description="Hardened Nginx container serving React 18 / Tailwind CSS client-facing frontend" \
      org.opencontainers.image.vendor="Enterprise AP Solution Team"

# Security: Create non-root appgroup and appuser (UID 10001) with nologin shell
RUN addgroup -g 10001 appgroup && \
    adduser -D -u 10001 -s /sbin/nologin -G appgroup appuser

# Copy custom hardened unprivileged nginx configuration
COPY frontend/nginx.conf /etc/nginx/nginx.conf

# Copy compiled static assets from builder
COPY --from=builder --chown=appuser:appgroup /app/dist /usr/share/nginx/html

# Prepare writable directories for non-root user
RUN mkdir -p /var/cache/nginx /var/run /tmp/client_temp /tmp/proxy_temp_path && \
    chown -R appuser:appgroup /var/cache/nginx /var/run /usr/share/nginx/html /tmp

# Switch to non-root user
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
